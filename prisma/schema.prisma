// ==========================================================
//  Uniwersytet Warszawski RP — schema.prisma
//  Baza: PostgreSQL (relacyjna — wybrana ze względu na silne
//  powiązania Character <-> Faculty <-> Grade <-> Exam)
// ==========================================================

generator client {
  provider = "prisma-client-js"
  output   = "../bot/node_modules/.prisma/client"
}

generator dashboardClient {
  provider = "prisma-client-js"
  output   = "../dashboard/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- RDZEŃ: UŻYTKOWNICY, ROLE, KONFIG ----------

model DiscordUser {
  id            String        @id // discordId
  robloxId      String?       @unique
  robloxUsername String?
  verifiedAt    DateTime?
  aiCredits     Float         @default(2)
  aiCreditsResetAt DateTime   @default(now())
  character     Character?
  aiUsageLogs   AiUsageLog[]
  ticketsOwned  Ticket[]      @relation("TicketOwner")
  grades        Grade[]
  punishments   Punishment[]
  examAnswers   ExamAnswer[]
  verificationReviews VerificationReview[] @relation("VerificationReviewer")
  applicationReviews  ApplicationReview[] @relation("ApplicationReviewer")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model RoleBinding {
  id             String  @id @default(cuid())
  discordRoleId  String
  permissionKey  String  // np. MANAGE_EXAMS, DONATE_UNLIMITED_AI, MODERATE, STUDY_YEAR_ROLE
  label          String  // czytelna nazwa z Dashboardu
  facultyId      String? // jeśli rola jest przypisana do konkretnego wydziału (kadra)
  faculty        Faculty? @relation(fields: [facultyId], references: [id])
  studyYear      Int?    // tylko dla permissionKey = STUDY_YEAR_ROLE, np. "Student Pierwszego Roku" -> 1

  @@unique([discordRoleId, permissionKey])
}

model ChannelBinding {
  id         String @id @default(cuid())
  key        String @unique // np. LOG_MOD, LOG_AI, APPLICATIONS_STUDENT, VERIFICATION, ANNOUNCEMENTS, TICKET_TRANSCRIPTS, VERIFICATION_REVIEW
  channelId  String
}

// ---------- MODUŁ AI ----------

model GeneralConfig {
  id               String  @id @default("singleton")
  serverInviteLink String? // link zapraszający na serwer, wysyłany np. w wiadomości zgody na dołączenie do koła
}

model AiConfig {
  id                String   @id @default("singleton")
  provider          String   @default("huggingface") // WYŁĄCZNIE Hugging Face
  apiKeyEncrypted   String   // token Hugging Face (hf_...), szyfrowany AES-256-GCM
  chatModel         String   @default("meta-llama/Llama-3.1-8B-Instruct") // model do bramki AI (chat completions)
  premiumChatModel  String?  // opcjonalny, lepszy model dla ról z DONATE_UNLIMITED_AI
  automodModel      String   @default("unitary/toxic-bert") // model klasyfikacyjny do automodu
  automodThreshold  Float    @default(0.7) // próg pewności (0-1)
  allowedChannelIds String[] // bramka AI tylko na tych kanałach
  automodEnabled    Boolean  @default(true)
  // Nowe pola dla weryfikacji i aplikacji
  verificationAnalysisModel String @default("facebook/bart-large-mnli") // MNLI do oceny logiczności danych
  applicationAnalysisModel String @default("mistral-community/Mistral-7B-Instruct-v0.2") // model do analizy treści podań
  verificationAiEnabled Boolean @default(true) // czy AI ma analizować dane weryfikacji
  applicationAiEnabled Boolean @default(true)  // czy AI ma analizować podania
  koloAiEnabled Boolean @default(true)         // czy AI ma analizować podania kół naukowych (rejestracja/badania/zmiany)
  updatedAt         DateTime @updatedAt
}

model AiPricingTier {
  id          String @id @default(cuid())
  minChars    Int
  maxChars    Int?   // null = bez górnej granicy
  creditCost  Float
}

model AiUsageLog {
  id         String      @id @default(cuid())
  user       DiscordUser @relation(fields: [userId], references: [id])
  userId     String
  channelId  String
  charCount  Int
  creditCost Float
  unlimited  Boolean     @default(false) // true jeśli rola donate pokryła koszt
  createdAt  DateTime    @default(now())
}

// ---------- WERYFIKACJA Z AI I MANUALNYM PRZEGLĄDEM ----------

model VerificationAttempt {
  id               String      @id @default(cuid())
  userId           String      @unique
  firstNameIC      String
  lastNameIC       String
  birthDateIC      DateTime
  genderIC         Gender
  robloxUserId     String
  robloxUsername   String
  
  // AI analysis
  aiAnalysis       String?     @db.Text // JSON z wynikami analizy AI
  aiScore          Float?      // 0-1, jak "dobry" jest kandydat wg AI
  aiFlags          String[]    // czerwone flagi: ["imie_podejrzane", "data_nierealistyczna", itp.]
  aiAnalyzedAt     DateTime?
  
  // Status przepływu
  status           VerificationStatus @default(PENDING_CAPTCHA) // PENDING_CAPTCHA -> PENDING_ROBLOX -> PENDING_AI_REVIEW -> PENDING_MANUAL_REVIEW -> VERIFIED / REJECTED
  captchaVerified  Boolean     @default(false)
  robloxVerified   Boolean     @default(false)
  
  // Recenzja manualna
  manualReview     VerificationReview?
  
  createdAt        DateTime    @default(now())
  expiresAt        DateTime    @default(dbgenerated("now() + interval '24 hours'"))
  @@index([status, createdAt])
}

enum VerificationStatus {
  PENDING_CAPTCHA      // czeka na wpisanie captchy
  PENDING_ROBLOX       // czeka na potwierdzenie konta Roblox
  PENDING_AI_REVIEW    // czeka na analizę AI
  PENDING_MANUAL_REVIEW // czeka na manualny przegląd przez moderatora
  VERIFIED             // zaakceptowana
  REJECTED             // odrzucona
  EXPIRED              // wygasła (24h limit)
}

model VerificationReview {
  id              String      @id @default(cuid())
  attempt         VerificationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId       String      @unique
  
  reviewer        DiscordUser @relation("VerificationReviewer", fields: [reviewerId], references: [id])
  reviewerId      String
  
  decision        VerificationDecision
  reason          String?     @db.Text // dlaczego zaakceptowana/odrzucona
  notes           String?     @db.Text // notatki moderatora
  
  createdAt       DateTime    @default(now())
}

enum VerificationDecision {
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
}

// ---------- POSTACIE / RP ----------

model Character {
  id               String      @id @default(cuid())
  user             DiscordUser @relation(fields: [userId], references: [id])
  userId           String      @unique
  firstNameIC      String
  lastNameIC       String
  birthDateIC      DateTime
  genderIC         Gender
  pesel            String      @unique
  yearOfStudy      Int?        @default(1)
  salaryIC         Int         @default(0)
  facultyId        String?
  faculty          Faculty?    @relation(fields: [facultyId], references: [id])
  scientificTitle  String?     // sync z RoleBinding tytułów naukowych
  albumNumber      String      @unique @default(cuid())
  legitValidUntil  DateTime?   // ważność legitymacji - ustawiana przy utworzeniu postaci, przedłużana przez dziekanat
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

enum Gender {
  MALE
  FEMALE
}

model Faculty {
  id           String        @id @default(cuid())
  name         String        @unique
  characters   Character[]
  subjects     Subject[]
  roleBindings RoleBinding[]
}

// ---------- SYLABUSY / ECTS ----------

model Subject {
  id         String     @id @default(cuid())
  name       String
  facultyId  String
  faculty    Faculty    @relation(fields: [facultyId], references: [id])
  ectsPoints Int        @default(0)
  syllabus   Syllabus?
  questions  ExamQuestion[]
  grades     Grade[]
  attendanceEntries AttendanceEntry[]

  @@unique([name, facultyId])
}

model Syllabus {
  id         String   @id @default(cuid())
  subjectId  String   @unique
  subject    Subject  @relation(fields: [subjectId], references: [id])
  content    String   @db.Text // markdown edytowany z Dashboardu
  updatedAt  DateTime @updatedAt
}

// ---------- EGZAMINY (DM) ----------

model ExamQuestion {
  id         String   @id @default(cuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id])
  topic      String
  content    String   @db.Text
  order      Int      @default(0)
}

model ExamSession {
  id          String        @id @default(cuid())
  subjectId   String
  topic       String
  channelId   String        // kanał wydziału, na którym wywołano start
  resultsChannelId String
  startedById String
  status      ExamStatus    @default(ONGOING)
  createdAt   DateTime      @default(now())
  closedAt    DateTime?
  answers     ExamAnswer[]
}

enum ExamStatus {
  ONGOING
  CLOSED
}

model ExamAnswer {
  id         String      @id @default(cuid())
  session    ExamSession @relation(fields: [sessionId], references: [id])
  sessionId  String
  user       DiscordUser @relation(fields: [userId], references: [id])
  userId     String
  questionId String
  answer     String      @db.Text
  answeredAt DateTime    @default(now())

  @@unique([sessionId, userId, questionId])
}

// ---------- USOS / OCENY ----------

model Grade {
  id         String      @id @default(cuid())
  user       DiscordUser @relation(fields: [userId], references: [id])
  userId     String
  subjectId  String
  subject    Subject     @relation(fields: [subjectId], references: [id])
  value      Float       // skala 2.0 - 5.0
  issuedById String
  createdAt  DateTime    @default(now())
}

// ---------- FREKWENCJA (wpisywana ręcznie przez wykładowcę) ----------

model AttendanceEntry {
  id             String   @id @default(cuid())
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id])
  studentId      String
  lecturerId     String   // kto wpisał
  present        Boolean  @default(true)
  activityPoints Int      @default(0)
  sessionDate    DateTime @default(now())
  note           String?

  @@index([subjectId, studentId])
}

// ---------- STYPENDIA / BIBLIOTEKA / KOŁA / PRACE DYPLOMOWE ----------

model Scholarship {
  id        String   @id @default(cuid())
  userId    String
  amountIC  Int
  gpaAtIssue Float
  issuedAt  DateTime @default(now())
}

model LibraryResource {
  id          String    @id @default(cuid())
  title       String
  totalCopies Int       @default(1)
  loans       LibraryLoan[]
}

model LibraryLoan {
  id          String          @id @default(cuid())
  resourceId  String
  resource    LibraryResource @relation(fields: [resourceId], references: [id])
  userId      String
  borrowedAt  DateTime        @default(now())
  dueAt       DateTime
  returnedAt  DateTime?
}

// AttendanceLog: automatyczne śledzenie czasu na kanałach głosowych ("sale
// wykładowe"), używane przez attendanceService.js + voiceStateUpdate.js.
// To coś innego niż AttendanceEntry (ręczne odznaczanie obecności przez
// wykładowcę per przedmiot) - oba systemy współistnieją.
model AttendanceLog {
  id              String    @id @default(cuid())
  userId          String
  voiceChannelId  String
  joinedAt        DateTime
  leftAt          DateTime?
  durationSec     Int?

  @@index([userId, joinedAt])
}

model UserLevel {
  id            String    @id @default(cuid())
  userId        String    @unique
  xp            Int       @default(0)
  level         Int       @default(0)
  lastMessageAt DateTime? // cooldown XP z wiadomości (60s)
  voiceJoinedAt DateTime? // kiedy dołączył do kanału głosowego (do naliczenia XP przy wyjściu)
  updatedAt     DateTime  @updatedAt
}

model LevelRoleReward {
  id     String @id @default(cuid())
  level  Int    @unique
  roleId String
}

model ThesisRegistration {
  id           String   @id @default(cuid())
  studentId    String
  supervisorId String
  title        String
  status       ThesisStatus @default(IN_PROGRESS)
  updatedAt    DateTime @updatedAt
}

enum ThesisStatus {
  IN_PROGRESS
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model ConditionalRetake {
  id         String   @id @default(cuid())
  userId     String
  subjectId  String
  feeIC      Int
  reportedAt DateTime @default(now())
}

// ---------- KARY DYSCYPLINARNE ----------

model Punishment {
  id         String   @id @default(cuid())
  user       DiscordUser @relation(fields: [userId], references: [id])
  userId     String
  issuedById String
  reason     String
  severity   PunishmentSeverity
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
}

enum PunishmentSeverity {
  UPOMNIENIE
  NAGANA
  ZAWIESZENIE
  WYDALENIE // trigger: automatyczne zabranie roli Studenta
}

// ---------- TICKETY ----------

model Ticket {
  id           String        @id @default(cuid())
  owner        DiscordUser   @relation("TicketOwner", fields: [ownerId], references: [id])
  ownerId      String
  categoryKey  String
  channelId    String
  assignedToId String?
  status       TicketStatus  @default(OPEN)
  transcriptHtml String?     @db.Text
  createdAt    DateTime      @default(now())
  closedAt     DateTime?
}

enum TicketStatus {
  OPEN
  CLAIMED
  CLOSED
}

// ---------- PODANIA REKRUTACYJNE ----------

model Application {
  id         String   @id @default(cuid())
  userId     String
  type       ApplicationType
  answers    Json
  
  // AI analysis (wstępna ocena)
  aiAnalysis String?  @db.Text // JSON: sentiment, słowa kluczowe, sugestia
  aiScore    Float?   // 0-1, jak "dobra" jest aplikacja wg AI
  aiFlags    String[] // czerwone flagi: ["spam", "plagiacja_podejrzana", itp.]
  aiAnalyzedAt DateTime?
  
  status     ApplicationStatus @default(PENDING)
  reviews    ApplicationReview[] // historia recenzji
  reviewedById String? // ostatni recenzent
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([status, userId])
}

enum ApplicationType {
  STUDENT
  WYKLADOWCA
  ADMINISTRACJA
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  NEEDS_CLARIFICATION
}

model ApplicationReview {
  id              String      @id @default(cuid())
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId   String
  
  reviewer        DiscordUser @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  reviewerId      String
  
  decision        ApplicationStatus // co zdecydował recenzent
  feedback        String?     @db.Text // komentarz dla kandydata
  internalNotes   String?     @db.Text // notatki dla zespołu (niewidoczne dla kandydata)
  
  createdAt       DateTime    @default(now())
}

// ---------- INTEGRACJE SOCIAL MEDIA ----------

model SocialMediaConfig {
  id                              String   @id @default("singleton")
  twitchClientId                  String?
  twitchClientSecretEncrypted     String?
  youtubeApiKeyEncrypted          String?
  instagramAccessTokenEncrypted   String?
  twitterBearerTokenEncrypted     String?
  pollIntervalMinutes             Int      @default(5)
  updatedAt                       DateTime @updatedAt
}

model SocialMediaSubscription {
  id               String         @id @default(cuid())
  platform         SocialPlatform
  externalHandle   String
  discordChannelId String
  lastSeenId       String?
  enabled          Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@unique([platform, externalHandle, discordChannelId])
}

// ---------- NPC (AI gra postaciami tła) ----------

model NpcCharacter {
  id          String   @id @default(cuid())
  name        String   @unique
  personality String   @db.Text
  avatarUrl   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

enum SocialPlatform {
  TWITCH
  YOUTUBE
  INSTAGRAM
  TWITTER
  TIKTOK
}

// ---------- WERYFIKACJA ----------

model VerificationConfig {
  id                String   @id @default("singleton")
  captchaCodeLength Int      @default(6)
  robloxCodeLength  Int      @default(8)
  panelTitle        String   @default("🎓 Weryfikacja — Uniwersytet Centralny RP")
  panelDescription  String   @default("Kliknij przycisk poniżej, aby rozpocząć weryfikację. Podasz Imię i Nazwisko IC oraz datę urodzenia, przejdziesz captchę, a na końcu połączymy Twoje konto z Robloxem.")
  robloxInstructions String  @default("Wejdź na swój profil Roblox → Edytuj profil → Opis (About), wklej podany kod, zapisz zmiany, wróć tutaj i kliknij \"Sprawdź teraz\".") @db.Text
  manualReviewRequired Boolean @default(true) // czy wymaga recenzji manualnej przed VERIFIED
  aiReviewRequired Boolean @default(true)     // czy wymaga analizy AI
  updatedAt         DateTime @updatedAt
}

// ---------- REACTION ROLE / AUTOROLE ----------

model ReactionRoleGroup {
  id          String               @id @default(cuid())
  key         String               @unique
  title       String
  description String?              @db.Text
  options     ReactionRoleOption[]
  createdAt   DateTime             @default(now())
}

model ReactionRoleOption {
  id             String            @id @default(cuid())
  groupId        String
  group          ReactionRoleGroup @relation(fields: [groupId], references: [id])
  discordRoleIds String[]
  label          String
  emoji          String?
  style          ButtonStyleOption @default(SECONDARY)
  order          Int               @default(0)
}

enum ButtonStyleOption {
  PRIMARY
  SECONDARY
  SUCCESS
  DANGER
}

// ---------- LOGI ----------

model ActionLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  
  @@index([action, createdAt])
}

// ---------- KOŁA NAUKOWE ----------

model Kolo {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String        @db.Text
  logoUrl      String?
  colorHex     String        @default("#FFFFFF") // dominujący kolor loga (wykryty automatycznie) lub biały domyślnie
  leaderId     String
  status       KoloStatus    @default(PENDING_MEMBERS)

  categoryId          String? // kategoria kanałów na serwerze
  channelAnnouncements String?
  channelChat          String?
  channelResearch      String?
  channelManage        String?
  channelDocuments     String? // kanał forum
  channelVoice         String?

  roleIdDivider String? // "przedziałka" •══════• Nazwa •══════• - wizualny separator, mają go wszyscy członkowie
  roleIdLeader  String? // • Lider Koła Naukowego •
  roleIdVice    String? // • Wicelider Koła Naukowego •
  roleIdMember  String? // • Członek Koła Naukowego •

  belowMinSince DateTime?    // od kiedy koło jest poniżej wymaganego minimum (start licznika 72h)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  members      KoloMember[]
  invites      KoloInvite[]
  researches   Research[]
  changeRequests KoloChangeRequest[]
  customRoles  KoloCustomRole[]

  @@index([status])
}

// Dodatkowe role poza domyślnymi 3 (Lider/Wicelider/Członek), zaakceptowane
// przez admina. Format nazwy wymuszony w kodzie: "• Nazwa •".
model KoloCustomRole {
  id        String   @id @default(cuid())
  koloId    String
  kolo      Kolo     @relation(fields: [koloId], references: [id], onDelete: Cascade)
  name      String
  roleId    String
  createdAt DateTime @default(now())

  @@unique([koloId, name])
}

enum KoloStatus {
  PENDING_MEMBERS  // czeka aż min. 4 osoby (lider + 3) zaakceptują zaproszenie
  PENDING_REVIEW   // wszyscy zaakceptowali, czeka na AI + admina
  ACTIVE
  REJECTED
  DISSOLVED
}

model KoloMember {
  id            String        @id @default(cuid())
  koloId        String
  kolo          Kolo          @relation(fields: [koloId], references: [id], onDelete: Cascade)
  userId        String
  role          KoloMemberRole @default(MEMBER)
  currentRoleId String?       // ID roli Discord aktualnie nadanej (jedna "treściowa" rola naraz, oprócz przedziałki)
  consentGiven  Boolean       @default(false) // czy kliknął przycisk zgody po zatwierdzeniu koła (przed nadaniem ról)
  joinedAt      DateTime      @default(now())

  @@unique([koloId, userId])
  @@index([userId])
}

enum KoloMemberRole {
  LEADER
  VICE_LEADER
  MEMBER
}

model KoloInvite {
  id        String       @id @default(cuid())
  koloId    String
  kolo      Kolo         @relation(fields: [koloId], references: [id], onDelete: Cascade)
  userId    String
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())
  expiresAt DateTime

  @@unique([koloId, userId])
  @@index([userId, status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model KoloChangeRequest {
  id          String              @id @default(cuid())
  koloId      String
  kolo        Kolo                @relation(fields: [koloId], references: [id], onDelete: Cascade)
  requestedBy String
  type        KoloChangeType
  payload     Json                // np. { "newName": "..." } / { "newLogoUrl": "..." } / { "newLeaderId": "..." }
  status      ChangeRequestStatus @default(PENDING_REVIEW)
  aiScore     Float?
  aiAnalysis  Json?
  createdAt   DateTime            @default(now())
}

enum ChangeRequestStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum KoloChangeType {
  NAME
  LOGO
  LEADER
  NEW_ROLE
  DISSOLVE
}

model ResearchTopic {
  id        String   @id @default(cuid())
  title     String   @unique
  active    Boolean  @default(true) // admin może wyłączyć bez usuwania historii
  createdAt DateTime @default(now())
}

model Research {
  id           String         @id @default(cuid())
  koloId       String
  kolo         Kolo           @relation(fields: [koloId], references: [id], onDelete: Cascade)
  topic        String         // z ResearchTopic.title LUB własny temat zaproponowany przez koło
  isCustomTopic Boolean       @default(false)
  status       ResearchStatus @default(PENDING_REVIEW)
  aiScore      Float?
  aiAnalysis   Json?
  startedAt    DateTime?
  pausedAt     DateTime?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())

  members ResearchMember[]

  @@index([koloId, status])
}

enum ResearchStatus {
  PENDING_REVIEW // czeka na AI + admina (dot. własnego tematu)
  ACTIVE
  PAUSED
  REJECTED
  COMPLETED
}

model ResearchMember {
  id         String   @id @default(cuid())
  researchId String
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  userId     String
  assignedAt DateTime @default(now())

  @@unique([researchId, userId])
}

// ---------- DIAGNOSTYKA I BŁĘDY ----------

model ErrorLog {
  id            String   @id @default(cuid())
  service       String   // np. "verificationService", "applicationService"
  errorType     String   // np. "CAPTCHA_FAILED", "AI_TIMEOUT"
  message       String   @db.Text
  stackTrace    String?  @db.Text
  context       Json?    // dodatkowe dane (userId, aplikacjaId, itp.)
  severity      String   @default("INFO") // INFO, WARNING, ERROR, CRITICAL
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())
  
  @@index([service, severity, createdAt])
}
