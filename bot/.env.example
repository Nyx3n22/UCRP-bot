DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

DATABASE_URL=postgresql://user:password@localhost:5432/uwrp

# 32-bajtowy klucz base64 do szyfrowania tokena Hugging Face trzymanego w bazie (AiConfig.apiKeyEncrypted)
ENCRYPTION_KEY=

# rover | bloxlink | custom
ROBLOX_VERIFY_PROVIDER=rover
BLOXLINK_API_KEY=

# UWAGA: token Hugging Face (hf_...) NIE jest tu ustawiany.
# Wpisuje się go w Dashboardzie (zakładka "Moduł AI"), skąd trafia
# zaszyfrowany do AiConfig.apiKeyEncrypted. Bot go tylko odszyfrowuje w locie.
