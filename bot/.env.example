DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# ID DRUGIEGO serwera Discord, na którym żyją Koła Naukowe (kategoria, kanały
# i role koła). Bot musi być tam zaproszony z uprawnieniami Manage Roles +
# Manage Channels. Bez tej zmiennej koła nie dadzą się aktywować ani posprzątać
# na Discordzie (baza i tak jest sprzątana - patrz koloService._teardownKolo).
KOLA_GUILD_ID=

DATABASE_URL=postgresql://user:password@localhost:5432/uwrp

# 32-bajtowy klucz base64 do szyfrowania tokena Hugging Face trzymanego w bazie (AiConfig.apiKeyEncrypted)
ENCRYPTION_KEY=

# UWAGA: weryfikacja Roblox jest teraz w pełni własną implementacją (kod w opisie
# profilu, publiczne Roblox API) - nie ma potrzeby konfigurować RoVer/Bloxlink.

# UWAGA: token Hugging Face (hf_...) NIE jest tu ustawiany.
# Wpisuje się go w Dashboardzie (zakładka "Moduł AI"), skąd trafia
# zaszyfrowany do AiConfig.apiKeyEncrypted. Bot go tylko odszyfrowuje w locie.
