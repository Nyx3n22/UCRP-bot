DATABASE_URL=postgresql://user:password@localhost:5432/uwrp

# Discord OAuth2 App (Developer Portal -> OAuth2), redirect: <URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Token bota - używany TYLKO do odczytu ról usera (fetchGuildMemberRoleIds), nie do wysyłania wiadomości
DISCORD_BOT_TOKEN=
GUILD_ID=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Ten sam klucz co w bot/.env - musi być identyczny, inaczej Dashboard i bot
# nie będą w stanie odszyfrować tokenów zapisanych przez siebie nawzajem
ENCRYPTION_KEY=
